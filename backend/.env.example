# Salin ke .env.local (lokal) atau isi sebagai Environment Variables di Vercel.
# JANGAN pernah nilai ini masuk ke repo Flutter — token Turso pernah bocor
# lewat web build karena .env didaftarkan sebagai asset.

# --- Turso (server-only, tidak pernah sampai ke klien) ---
# URL dari: turso db show <nama-db> --url
TURSO_URL=libsql://zest-<org>.turso.io
# Token READ-WRITE. Buat baru lalu cabut yang lama setelah backend ter-deploy.
TURSO_TOKEN=

# --- Google OAuth ---
# Client ID yang sah sebagai audience idToken, dipisah koma.
# Waajib memuat web + iOS; Android memakai web client id (lihat AuthConfig.resolve).
#   web     = 839941751943-g4l0vfqhkjm2h6fpi4ub4106ue8i3vo2.apps.googleusercontent.com
#   ios     = 839941751943-ldv4jglnno4r482292r1avdnplp6id7d.apps.googleusercontent.com
#   android = 839941751943-9gm8cqqtci5ucuquc5622bpr134d482k.apps.googleusercontent.com
GOOGLE_AUDIENCES=

# --- CORS ---
# Origin yang boleh memanggil API, dipisah koma, tanpa trailing slash.
# Port WAJIB ikut ditulis karena origin dicocokkan persis.
ALLOWED_ORIGINS=http://localhost:8080

# --- Session web (opsional) ---
# Secret HMAC untuk session token (zest_session.*) yang diterbitkan
# POST /api/me/profile agar web tetap login ≤1 hari saat reload.
# Tanpa ini fitur sesi nonaktif (API tetap jalan dengan idToken Google saja).
# Minimal 16 karakter; generate: openssl rand -hex 32
SESSION_SECRET=
# Masa berlaku session token dalam jam (default 24).
SESSION_TTL_HOURS=24

# --- Lokal saja ---
PORT=3000
