# Salin file ini menjadi `.env` lalu isi nilai sebenarnya.
#
# File ini TERDAFTAR sebagai asset Flutter, jadi ikut ter-bundle ke
# `build/web/assets/.env` dan bisa diunduh siapa saja. Karena itu isinya
# WAJIB nilai publik saja. Jangan pernah menaruh token database, API key, atau
# secret apa pun di sini.
#
# Test `test/env_secret_guard_test.dart` menegakkan aturan ini.
#
# Untuk backend, salin `backend/.env.example` menjadi `backend/.env.local`
# (gitignored) — di situlah TURSO_TOKEN berada.

# Basis URL backend. Bakal public juga, jadi ini bukan secret.
API_BASE_URL = http://localhost:3000

# --- Google OAuth (client id = nilai publik, aman di bundle) ---
GOOGLE_WEB_CLIENT_ID =
GOOGLE_ANDROID_CLIENT_ID =
GOOGLE_IOS_CLIENT_ID =

# --- TTS (VOICEVOX) — opsional, hanya untuk dev; production pakai asset audio ---
# VOICEVOX_BASE_URL = http://localhost:50021  (emulator Android: http://10.0.2.2:50021)
# VOICEVOX_SPEAKER_ID = 2
VOICEVOX_BASE_URL =
VOICEVOX_SPEAKER_ID =
